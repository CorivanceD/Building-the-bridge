# Database host; "db" is the bundled MariaDB service, set an external host to use that instead.
DB_HOST=db
# Database name (must match the dump you import).
DB_DATABASE=bvkempen_btbdb
# Database user (created by MariaDB on first start).
DB_USER=bvkempen_btbuser
# Password for DB_USER; must not be empty or change-me.
DB_PASSWORD=change-me
# MariaDB root password; must not be empty or change-me.
DB_ROOT_PASSWORD=change-me
# Published HTTP port (keep 80 or the http->https redirect breaks).
WEB_HTTP_PORT=80
# Published HTTPS port (keep 443).
WEB_HTTPS_PORT=443
# Port for the Mailpit web UI (catches outgoing mail).
MAIL_UI_PORT=8025
# Port for the phpMyAdmin web UI.
PMA_PORT=8081
# PHP version used for the web image build. 8.4 = production target (the Plesk server offers 8.4.27); 5.6 = old code for comparison
PHP_VERSION=8.4
